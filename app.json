{
  "expo": {
    "name": "FamilyLoop",
    "slug": "familyloop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "familyloop",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.familyloop.mobile"
    },
    "android": {
      "package": "net.familyloop.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17233f"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "FamilyLoop uses your photos to attach them to journal entries."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://familyloop.net"
    }
  }
}
